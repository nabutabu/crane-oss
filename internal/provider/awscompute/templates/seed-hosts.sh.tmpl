#!/usr/bin/env bash
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
umask 077
DB_USER="$(jq -r '.crane_username' /var/lib/crane/runtime-secret.json)"
export PGPASSWORD="$(jq -r '.crane_password' /var/lib/crane/runtime-secret.json)"
ZONE_ID="$(jq -r '.zone.id' /etc/crane/first-zone.rendered.json)"
psql "host=[[ .Infra.DBEndpoint ]] port=[[ .Config.RDS.Port ]] user=$DB_USER dbname=crane sslmode=verify-full sslrootcert=/etc/crane/rds-ca.pem" \
  -v ON_ERROR_STOP=1 -v zone="$ZONE_ID" <<'SQL'
BEGIN;
SELECT pg_advisory_xact_lock(724163002);
[[ range .Hosts ]]
INSERT INTO host(id,role,zone,imageid,state,health,createdat,provider,providerid,protected,subd_endpoint)
SELECT '[[ $.Config.Name ]]/bootstrap/[[ .Role ]]','[[ .Role ]]',:'zone','[[ .AMI ]]','CONVERGING','unknown',clock_timestamp(),'aws','[[ .ID ]]',true,'https://[[ .PrivateIP ]]:44001'
WHERE NOT EXISTS (SELECT 1 FROM host WHERE provider='aws' AND providerid='[[ .ID ]]')
ON CONFLICT (id) DO NOTHING;
SELECT count(*) = 1 AND bool_and(id='[[ $.Config.Name ]]/bootstrap/[[ .Role ]]' AND provider='aws' AND providerid='[[ .ID ]]' AND role='[[ .Role ]]' AND zone=:'zone' AND imageid='[[ .AMI ]]' AND state IN ('CONVERGING','READY') AND protected AND subd_endpoint='https://[[ .PrivateIP ]]:44001' AND node_group_id IS NULL AND node_pool_id IS NULL AND crane_zone IS NULL AND operation_id IS NULL)
 AS host_valid FROM host WHERE (provider='aws' AND providerid='[[ .ID ]]') OR id='[[ $.Config.Name ]]/bootstrap/[[ .Role ]]' \gset
\if :host_valid
\else
DO $$ BEGIN RAISE EXCEPTION 'conflicting bootstrap host catalog record'; END $$;
\endif
[[ end ]]
[[ range .Hosts ]][[ if eq .Role "platform" ]]
INSERT INTO zone_dominators(zone_id,endpoint,identity)
VALUES(:'zone','https://[[ .PrivateIP ]]:44000','spiffe://[[ $.TrustDomain ]]/dominator/[[ $.ZoneID ]]')
ON CONFLICT(zone_id) DO NOTHING;
SELECT count(*)=1 AND bool_and(endpoint='https://[[ .PrivateIP ]]:44000' AND identity='spiffe://[[ $.TrustDomain ]]/dominator/[[ $.ZoneID ]]') AS route_valid
 FROM zone_dominators WHERE zone_id=:'zone' \gset
\if :route_valid
\else
DO $$ BEGIN RAISE EXCEPTION 'conflicting bootstrap Dominator route'; END $$;
\endif
[[ end ]][[ end ]]
INSERT INTO deployment_runtime(cluster_id,deployment_id,provider,account_id,region,vpc_id,
 spire_host_id,platform_host_id,dominator_image,runtime_secret_name,trust_domain,pod_cidr)
VALUES('[[ .ClusterID ]]','[[ .Config.Name ]]','aws','[[ .Config.AWS.AccountID ]]',
 '[[ .Config.AWS.Region ]]','[[ .Infra.VPCID ]]',
 '[[ .Config.Name ]]/bootstrap/spire','[[ .Config.Name ]]/bootstrap/platform',
 '[[ .Config.Platform.DominatorImage ]]','crane-runtime','[[ .TrustDomain ]]',
 '[[ .Config.Platform.PodCIDR ]]')
ON CONFLICT(cluster_id) DO NOTHING;
SELECT count(*)=1 AND bool_and(deployment_id='[[ .Config.Name ]]' AND provider='aws'
 AND account_id='[[ .Config.AWS.AccountID ]]' AND region='[[ .Config.AWS.Region ]]'
 AND vpc_id='[[ .Infra.VPCID ]]' AND spire_host_id='[[ .Config.Name ]]/bootstrap/spire'
 AND platform_host_id='[[ .Config.Name ]]/bootstrap/platform'
 AND dominator_image='[[ .Config.Platform.DominatorImage ]]'
 AND runtime_secret_name='crane-runtime' AND trust_domain='[[ .TrustDomain ]]'
 AND pod_cidr='[[ .Config.Platform.PodCIDR ]]') AS deployment_valid
 FROM deployment_runtime WHERE cluster_id='[[ .ClusterID ]]' \gset
\if :deployment_valid
\else
DO $$ BEGIN RAISE EXCEPTION 'conflicting deployment runtime references'; END $$;
\endif
COMMIT;
SQL
unset PGPASSWORD
echo 'protected bootstrap hosts registered outside worker capacity'
