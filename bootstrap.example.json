{
  "version": 3,
  "name": "crane-platform",
  "provider": "aws",
  "provider_config": {
    "region": "us-west-2",
    "network": {
      "vpc_cidr": "10.80.0.0/16",
      "public_subnet_cidrs": [
        "10.80.0.0/24",
        "10.80.1.0/24"
      ],
      "private_subnet_cidrs": [
        "10.80.16.0/24",
        "10.80.17.0/24"
      ]
    },
    "rds": {
      "engine": "postgres",
      "instance_class": "db.t3.micro",
      "storage_gib": 20,
      "deletion_protection": true,
      "manage_master_user_password": true
    },
    "observability": {
      "new_relic_secret_arn": "arn:aws:secretsmanager:us-west-2:123456789012:secret:crane-platform/new-relic-abc123",
      "new_relic_otlp_endpoint": "https://otlp.nr-data.net"
    },
    "spire_host": {
      "instance_type": "t3.small",
      "storage_gib": 8
    },
    "platform_host": {
      "instance_type": "t3.small",
      "storage_gib": 40
    }
  },
  "spire": {
    "version": "1.9.3",
    "trust_domain": "crane.internal"
  },
  "platform": {
    "kubernetes_version": "v1.35.0",
    "cilium_version": "1.19.0",
    "pod_cidr": "10.244.0.0/16",
    "crane_api_image": "ghcr.io/nabutabu/crane-oss:0.2.0",
    "dominator_image": "ghcr.io/nabutabu/crane-oss-dominator:0.2.0"
  }
}
