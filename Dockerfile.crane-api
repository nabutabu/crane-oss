# syntax=docker/dockerfile:1
FROM golang:1.26-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build metadata is injected by the release workflow (see .github/workflows/release.yml).
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false \
      -ldflags "-s -w \
        -X github.com/nabutabu/crane-oss/internal/version.Version=${VERSION} \
        -X github.com/nabutabu/crane-oss/internal/version.Commit=${COMMIT} \
        -X github.com/nabutabu/crane-oss/internal/version.Date=${BUILD_DATE}" \
      -o /crane-api ./cmd/crane-api

FROM alpine:3.21@sha256:ce64758a109eb420d874a118f87920e625e12d3634e03b4a5573fd9f6e5d3507

RUN apk --no-cache add ca-certificates \
    && adduser -D -u 10001 app

WORKDIR /app

COPY --from=builder /crane-api .
COPY --from=builder /app/internal/provider/awscompute/cloud-init.yaml ./
COPY bhd.json ./

USER app

EXPOSE 43060

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:43060/health || exit 1

ENTRYPOINT ["./crane-api"]
